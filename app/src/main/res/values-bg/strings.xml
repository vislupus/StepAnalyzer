    <string name="method_gpx_avg_name">GPX средна</string>
    <string name="method_gpx_avg_desc">GPS дистанцията, разделена на референтния брой крачки. Най-пряката оценка при чист трак.</string>
    <string name="method_weinberg_name">Weinberg</string>
    <string name="method_weinberg_desc">L = K · ⁴√(a_max − a_min) за крачка. K е литературна стойност и се калибрира по GPS дистанцията, когато има трак.</string>
    <string name="method_kim_name">Kim</string>
    <string name="method_kim_desc">L = K · ³√(средно |a|) за крачка. Същата калибровка като при Weinberg.</string>
    <string name="method_scarlett_name">Scarlett</string>
    <string name="method_scarlett_desc">L = K · (средно |a| − a_min) / (a_max − a_min) за крачка. Същата калибровка като при Weinberg.</string>
    <string name="method_height_factor_name">Ръст × коефициент</string>
    <string name="method_height_factor_desc">Биомеханично правило: крачката е около 0.41–0.42 × ръста.</string>
    <string name="method_cadence_linear_name">Каданс (линеен)</string>
    <string name="method_cadence_linear_desc">L = 0.35 · f_step + 0.10 — дължината расте с честотата на крачките; не изисква ръст.</string>
    <string name="method_height_cadence_name">Ръст × каданс</string>
    <string name="method_height_cadence_desc">L = ръст · (0.15 · f_step + 0.15), модел в стил Renaudin, комбиниращ ръст и каданс.</string>
