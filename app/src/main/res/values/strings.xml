    <string name="method_gpx_avg_name">GPX average</string>
    <string name="method_gpx_avg_desc">GPS distance divided by the reference step count. The most direct estimate when the track is clean.</string>
    <string name="method_weinberg_name">Weinberg</string>
    <string name="method_weinberg_desc">L = K · ⁴√(a_max − a_min) per step. K defaults to a literature value and is calibrated to the GPS distance when a track exists.</string>
    <string name="method_kim_name">Kim</string>
    <string name="method_kim_desc">L = K · ³√(mean |a|) per step. Same calibration scheme as Weinberg.</string>
    <string name="method_scarlett_name">Scarlett</string>
    <string name="method_scarlett_desc">L = K · (mean |a| − a_min) / (a_max − a_min) per step. Same calibration scheme as Weinberg.</string>
    <string name="method_height_factor_name">Height × factor</string>
    <string name="method_height_factor_desc">Biomechanical rule of thumb: a step is about 0.41–0.42 × body height.</string>
    <string name="method_cadence_linear_name">Cadence (linear)</string>
    <string name="method_cadence_linear_desc">L = 0.35 · f_step + 0.10 — step length grows with step frequency; needs no height.</string>
    <string name="method_height_cadence_name">Height × cadence</string>
    <string name="method_height_cadence_desc">L = height · (0.15 · f_step + 0.15), Renaudin-style model combining height and cadence.</string>
